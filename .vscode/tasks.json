{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Typecheck ShiftSwap",
			"type": "shell",
			"command": "npx tsc --noEmit",
			"problemMatcher": [
				"$tsc"
			],
			"group": "test"
		},
		{
			"label": "Typecheck ShiftSwap with cmd",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npx.cmd tsc --noEmit"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "test"
		},
		{
			"label": "Lint ShiftSwap",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npx.cmd expo lint"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}